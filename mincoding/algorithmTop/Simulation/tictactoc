#include <iostream>
#include <string>

using namespace std;


struct Pair {
	char first;
	char second;
};


int solo = 0, team = 0;
char board[3][3];

int team_idx = 0;
Pair team_pairs[12];


/* 팀 존재 여부 반환 */
bool exist_team(char first, char second) {
	for (int i = 0; i < team_idx; i++) {
		if (team_pairs[i].first == first && team_pairs[i].second == second) {
			return true;
		}
	}

	return false;
}


/* 가로행 확인 */
void row_check() {
	for (int i = 0; i < 3; i++) {
		if (board[i][0] == board[i][1] && board[i][1] == board[i][2]) {
			if (!exist_team(board[i][0], board[i][1])) {
				team_pairs[team_idx++] = {board[i][0], board[i][1]};
				solo++;
			}
		} else if (board[i][0] == board[i][1] || board[i][0] == board[i][2] || board[i][1] == board[i][2]) {
			if (!exist_team(min(board[i][0], min(board[i][1], board[i][2])), max(board[i][0], max(board[i][1], board[i][2])))) {
				team_pairs[team_idx++] = { min(board[i][0], min(board[i][1], board[i][2])), max(board[i][0], max(board[i][1], board[i][2])) };
				team++;
			}
		}
	}
}


/* 세로열 확인 */
void col_check() {
	for (int i = 0; i < 3; i++) {
		if (board[0][i] == board[1][i] && board[1][i] == board[2][i]) {
			if (!exist_team(board[0][i], board[1][i])) {
				team_pairs[team_idx++] = { board[0][i], board[1][i] };
				solo++;
			}
		} else if (board[0][i] == board[1][i] || board[0][i] == board[2][i] || board[1][i] == board[2][i]) {
			if (!exist_team(min(board[0][i], min(board[1][i], board[2][i])), max(board[0][i], max(board[1][i], board[2][i])))) {
				team_pairs[team_idx++] = { min(board[0][i], min(board[1][i], board[2][i])), max(board[0][i], max(board[1][i], board[2][i])) };
				team++;
			}
		}
	}
}


/* 대각선 확인 */
void diag_check() {
	// 왼쪽 대각선
	if (board[0][0] == board[1][1] && board[1][1] == board[2][2]) {
		if (!exist_team(board[0][0], board[1][1])) {
			team_pairs[team_idx++] = { board[0][0], board[1][1] };
			solo++;
		}
	} else if (board[0][0] == board[1][1] || board[0][0] == board[2][2] || board[1][1] == board[2][2]) {
		if (!exist_team(min(board[0][0], min(board[1][1], board[2][2])), max(board[0][0], max(board[1][1], board[2][2])))) {
			team_pairs[team_idx++] = { min(board[0][0], min(board[1][1], board[2][2])), max(board[0][0], max(board[1][1], board[2][2])) };
			team++;
		}
	}

	// 오른쪽 대각선
	if (board[0][2] == board[1][1] && board[1][1] == board[2][0]) {
		if (!exist_team(board[0][2], board[1][1])) {
			team_pairs[team_idx++] = { board[0][2], board[1][1] };
			solo++;
		}
	} else if (board[0][2] == board[1][1] || board[0][2] == board[2][0] || board[1][1] == board[2][0]) {
		if (!exist_team(min(board[0][2], min(board[1][1], board[2][0])), max(board[0][2], max(board[1][1], board[2][0])))) {
			team_pairs[team_idx++] = { min(board[0][2], min(board[1][1], board[2][0])), max(board[0][2], max(board[1][1], board[2][0])) };
			team++;
		}
	}
}


int main() {

	cin.tie(nullptr);
	ios::sync_with_stdio(false);
	cout.tie(nullptr);

	for (int i = 0; i < 3; i++) {
		for (int j = 0; j < 3; j++) {
			cin >> board[i][j];
		}
	}

	row_check();
	col_check();
	diag_check();

	cout << solo << "\n" << team << "\n";

}
