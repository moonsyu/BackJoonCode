#include <iostream>
#include <vector>
#include <queue>

using namespace std;

struct Data {
    int y, x, time;
};


int dx[] = { 1, 0, -1, 0 };
int dy[] = { 0, 1, 0, -1 };

int n;
int start_x, start_y, end_x, end_y;
int sea[15][15];
bool visited[15][15];

queue<Data> que; // y, x, time

int bfs() {
    int answer = -1;
    while (!que.empty()) {
        auto [y, x, time] = que.front();
        que.pop();

        if (x == end_x && y == end_y) {
            answer = time;
            break;
        }

        for (int i = 0; i < 4; i++) {
            int nx = x + dx[i];
            int ny = y + dy[i];

            // 범위 확인
            if (nx < 0 || nx >= n || ny < 0 || ny >= n) {
                continue;
            }

            // 방문 확인
            if (!visited[ny][nx]) {
                continue;
            }

            if (!sea[ny][nx]) { // 0이면 이동 가능
                que.push({ ny, nx, time + 1 });
                visited[ny][nx] = false;
            }
            else if (sea[ny][nx] == 2) { // 2일 때
                if (!((time + 1) % 3)) { // 소용돌이가 사라지면 이동
                    que.push({ ny, nx, time + 1 });
                    visited[ny][nx] = false;
                }
                else { // 소용돌이가 있으면 대기
                    que.push({ y, x, time + 1 });
                }
            }
        }
    }

	return answer;
}


int main() {

    int t;
    cin >> t;

    for (int tc = 1; tc <= t; tc++) {
        fill(&visited[0][0], &visited[0][0] + 15 * 15, true); // 방문 배열 초기화
        while (!que.empty()) que.pop(); // 큐 초기화
        cin >> n;

        // 바다 정보 입력
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                cin >> sea[i][j];    
            }
        }

        // 시작점과 도착점 입력
        cin >> start_y >> start_x >> end_y >> end_x;

		// 시작점 큐에 넣기
        que.push({ start_y, start_x, 0 });
        visited[start_y][start_x] = false;

        cout << "#" << tc << " " << bfs() << "\n";
    }
}